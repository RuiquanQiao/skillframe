{
  "name": "skillframe",
  "version": "0.1.4",
  "description": "Give your app a sidebar that runs your users' own coding agent (Claude Code, Codex, ACP agents) on their own subscription, wired both ways into your UI.",
  "keywords": [
    "claude-code",
    "codex",
    "coding-agent",
    "agent",
    "sidebar",
    "mcp",
    "acp",
    "web-component",
    "electron",
    "tauri",
    "claude",
    "anthropic",
    "openai",
    "qwen-code",
    "no-api-key",
    "subscription",
    "bring-your-own-agent",
    "byoa",
    "local-agent",
    "agent-bridge",
    "ai-sidebar",
    "ai-chat",
    "chat-ui",
    "agent-ui",
    "agent-client-protocol",
    "model-context-protocol"
  ],
  "author": "Ruiquan Qiao",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RuiquanQiao/skillframe.git",
    "directory": "packages/skillframe"
  },
  "homepage": "https://github.com/RuiquanQiao/skillframe#readme",
  "bugs": "https://github.com/RuiquanQiao/skillframe/issues",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./eject": "./bin/eject.js"
  },
  "bin": {
    "skillframe": "bin/skillframe.js"
  },
  "files": [
    "dist/src",
    "src",
    "bin",
    "ui"
  ],
  "scripts": {
    "prepack": "tsc -b && node -e \"require('node:fs').copyFileSync('../../README.md', 'README.md')\""
  },
  "engines": {
    "node": ">=22"
  }
}
