{
  "name": "skillframe",
  "version": "0.1.1",
  "description": "Give your app a sidebar that runs your users' own coding agent (Claude Code, Codex, ACP agents) on their own subscription, wired both ways into your UI.",
  "keywords": [
    "claude-code",
    "codex",
    "coding-agent",
    "agent",
    "sidebar",
    "mcp",
    "acp",
    "web-component",
    "electron"
  ],
  "author": "Ruiquan Qiao",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RuiquanQiao/skillframe.git",
    "directory": "packages/skillframe"
  },
  "homepage": "https://github.com/RuiquanQiao/skillframe#readme",
  "bugs": "https://github.com/RuiquanQiao/skillframe/issues",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "src",
    "bin",
    "ui"
  ],
  "scripts": {
    "prepack": "tsc -b && node -e \"require('node:fs').copyFileSync('../../README.md', 'README.md')\""
  },
  "engines": {
    "node": ">=22"
  }
}
